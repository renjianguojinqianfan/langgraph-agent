# ── Secrets & local config ─────────────────────────────
.env
.env.local
*.env
!.env.example

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# CI Windows job 在仓库根生成的 mcp 过滤副本（Linux job 写 /tmp）；本地复跑也会生成
requirements-ci.txt

# ── Virtual environments ───────────────────────────────
.venv/
.venv311/
venv/
env/

# ── Node / frontend ────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist_*/
frontend/dist_build/
dist/
*.tsbuildinfo

# ── Runtime data (never commit) ────────────────────────
data/
!data/.gitkeep

# ── OS / IDE ───────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ── Logs ───────────────────────────────────────────────
*.log
logs/

# ── AI agent local state ───────────────────────────────
# 各家 agent 专用目录 / 配置一律整体不入库（.qoder/.qoderignore/.trae/.mimosa/.workbuddy）。
# 决策类 / spec / 计划类文档归 docs/（见 docs/agents/domain.md「文档归属」）；
# 记忆类与工具态产物留原地、不跟踪。
.workbuddy/
.trae/
.trae-html-share-packages/
.mimosa/
.qoder/
.qoderignore
# 会话交接文档（handoff）：一次性工作稿，不入库；复盘 retros 仍跟踪
.agents/handoffs/
# 设计 / 调研草稿（本机临时工作稿，不入库；正式产物归 docs/）
.agents/temp/
_write_bh_report.py

# ── Impeccable skill runtime state ─────────────────────
# 来源：impeccable README「Project files and git」原样粘贴；上游更新时整块替换。
# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# The **/ prefix covers .impeccable at the repo root or in a nested workspace.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, surfaces/*.md, critique/*.md.
**/.impeccable/config.local.json
**/.impeccable/hook.cache.json
**/.impeccable/hook.pending.json
**/.impeccable/*.png
**/.impeccable/review/
**/.impeccable/questions/
**/.impeccable/live/server.json
**/.impeccable/live/sessions/
**/.impeccable/live/previews/
**/.impeccable/live/annotations/
**/.impeccable/live/cache/
**/.impeccable/live/manual-edit-apply-transaction.json
**/.impeccable/live/manual-edit-events.jsonl
**/.impeccable/live/manual-edit-evidence/
**/.impeccable/live/pending-manual-edits.json
**/.impeccable/live/deferred-svelte-component-accepts.json
**/.impeccable/live/*.png
# impeccable-ignore-end
