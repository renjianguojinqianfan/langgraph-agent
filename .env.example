# ── LLM provider ───────────────────────────────────────────────
# Provider preset: openai | deepseek | ollama | mock
llm_provider=openai
# For OpenAI-compatible hosts just change base_url (e.g. DeepSeek / Ollama).
llm_base_url=https://api.openai.com/v1
llm_api_key=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
llm_model=gpt-4o-mini
# Wall-clock limit for ONE llm request, in seconds. The OpenAI SDK default is
# 600s, which lets a single stalled request eat an entire task budget; the live
# end-to-end script derives its terminal budget from this value (#13).
llm_request_timeout_sec=90

# Offline mode: when true, a scripted MockLLMClient is used (no network / key).
use_mock_llm=false

# ── Agent ──────────────────────────────────────────────────────
# Max planner/executor iterations before a task is forced to end.
max_steps=15

# ── Completion verification (P0-B) ──────────────────────
# reflect re-checks deliverables before allowing finish: registered artifacts
# must exist and be non-empty (S1), and it flags "all tool calls failed yet
# claims done" (S2, triple-narrowed). On failure it loops back with evidence
# (bounded by verify_max_retries), then degrades to COMPLETED with a `degraded`
# marker — it never fails a task on a false negative. false = original no-op
# reflect (zero regression).
verify_enabled=true
# Bounded verify-fail loop-backs before degrading (max_steps is the outer cap).
verify_max_retries=2

# ── Sandbox ────────────────────────────────────────────────────
# Wall-clock timeout (seconds) for code execution.
sandbox_timeout=30

# ── Web search ─────────────────────────────────────────────────
# duckduckgo (free, no key) | serpapi (requires serpapi_key)
search_provider=duckduckgo
serpapi_key=

# ── Persistence ────────────────────────────────────────────────
# Relative paths resolve against the project root.
data_dir=data
artifacts_dir=data/artifacts

# ── Server ─────────────────────────────────────────────────────
host=0.0.0.0
port=8000
cors_origins=*

# ── Headless entry (P0-C) ─────────────────────────────
# No new fields. `python -m backend.headless -p "<task>" --dir <workdir>
# --auto-approve --output json` reuses the LLM_* / *_enabled settings above
# (env wins over .env). --auto-approve is an instance-scoped confirm-gate
# bypass for EVALUATION mode only; the FastAPI service path never enables it.

# ── Auth (disabled for local demo; enable on public deployments) ──
auth_enabled=false
auth_token=changeme
# Lifetime of issued tokens (seconds).
auth_token_ttl_sec=86400

# ── Context compression (P0) ─────────────────────────────────────
# Estimated tokens above this budget trigger compression (chars/4 estimate).
# 32000 ≈ a conservative mapping of dsh's ratio policy (0.8 x model window) for a
# 128K-window model: chars/4 under-counts real tokens 2~3x for Chinese-heavy
# history, so we do not copy the literal ~105K. Raise/lower freely.
context_token_budget=32000
# Keep the most recent N raw messages when compressing.
context_keep_recent=10
# 0 = only token-triggered; >0 also triggers by message count.
context_max_messages=0
# truncate (default, zero extra LLM calls) | summarize (requires LLM).
context_compress_strategy=truncate
context_summary_max_tokens=300

# ── Context injection (P1-A′) ────────────────────────────────────
# Master switch: inject the two-layer AGENTS.md chain (home ~/.agents/AGENTS.md
# then the workspace root = artifacts_dir), the skills catalogue and the
# environment facts into the planner/executor system prompt. Discovered+merged
# once per task — mid-task edits take effect on the NEXT task. The block is not
# counted against context_token_budget; false = pre-P1-A′ behaviour.
context_inject_enabled=true
# Character budget for the rendered skills cards (`- name: description`). Over
# budget drops whole cards from the tail; AGENTS.md and the env facts are never
# trimmed. Skills are discovered at ~/.agents/skills/*/SKILL.md and
# <artifacts_dir>/.agents/skills/*/SKILL.md; only name/description are used.
context_inject_skills_budget=4000

# ── Tool-result eviction (T1.4) ──────────────────────────────────
# Before compression, old tool results longer than the threshold are replaced
# in place by a placeholder: marker + tool name + original size + trace pointer
# + a head/tail preview. Purely mechanical (zero extra LLM calls); the full
# text stays in data/traces/<task_id>.jsonl. false = pre-T1.4 behaviour.
context_evict_enabled=true
# A single tool message longer than this many characters gets evicted.
context_evict_threshold_chars=4000
# The most recent N messages are never evicted (positional, role-agnostic).
context_evict_protect_recent=10
# Head/tail preview kept inside the placeholder.
context_evict_head_chars=800
context_evict_tail_chars=400

# ── Tool resilience (P0) ─────────────────────────────────────────
# Consecutive failures before the circuit opens.
tool_failure_threshold=3
# Seconds the circuit stays open before a half-open probe.
tool_cooldown_sec=30
tool_backoff_base=1.0
tool_backoff_factor=2
# Global default max retries (tools may override individually).
tool_max_retries=2

# ── Plugins (P0) ─────────────────────────────────────────────────
# Directory scanned for BaseTool plugins (relative to project root).
plugins_dir=backend/plugins
plugins_autoload=true

# ── Trace (P0) ───────────────────────────────────────────────────
trace_enabled=true
trace_dir=data/traces

# ── Risk scan (P1) ───────────────────────────────────────────────
# Master switch; when false the risk node is skipped entirely.
risk_scan_enabled=true
# LLM semantic analysis (optional; needs an aux or the main model).
risk_semantic_enabled=false
# confirm (per-call human confirm for high-risk steps) | pause (plan-level block).
risk_policy=confirm
# Optional JSON array overriding the built-in danger keyword table (empty = built-in).
risk_danger_keywords=

# ── Sub-agent (P1) ───────────────────────────────────────────────
subagent_enabled=true
# Thread-pool parallelism for subtasks (1 = serial).
subagent_max_concurrency=2
# Single-subtask wall-clock timeout (seconds).
subagent_timeout_sec=120

# ── Knowledge base (P1) ──────────────────────────────────────────
kb_enabled=true
kb_dir=data/kb
# Register produced artifacts into the KB automatically.
kb_auto_index_artifacts=true
kb_chunk_size=2000
# Vector retrieval placeholder; false = offline keyword retrieval.
kb_embedding_enabled=false
kb_top_k=5

# ── Aux LLM (P1) ─────────────────────────────────────────────────
# Disabled by default: zero extra LLM calls. Enable to delegate summary /
# risk-semantic / tool-choice work to a cheaper auxiliary model.
aux_llm_enabled=false
aux_llm_provider=openai
aux_llm_base_url=
aux_llm_api_key=
aux_llm_model=
aux_llm_use_mock=false

# ── OpenAPI tools (P1) ───────────────────────────────────────────
openapi_enabled=false
openapi_spec_path=
openapi_spec_url=
openapi_api_key=
# JSON object of headers applied to every generated OpenAPI call.
openapi_global_headers={}

# ── MCP client (P2) ──────────────────────────────────────────────
# Master switch; when false no MCP servers are connected and no MCP tools exist.
mcp_enabled=true
# JSON array: [{name, command, args[], env{}, enabled, cwd?, transport?, url?}]
# Example: [{"name":"fs","command":"npx.cmd","args":["-y","@modelcontextprotocol/server-filesystem","./data"],"enabled":true}]
# Windows note: use "npx.cmd" (or a full Node path) so subprocess can resolve it.
mcp_servers=[]
# Timeout for a single MCP call_tool (seconds).
mcp_timeout_sec=30
# Timeout for initialize + list_tools per server (seconds).
mcp_connect_timeout_sec=15
# JSON array of mcp__{server}__{tool} full names that always require confirm.
mcp_force_confirm=[]

# ── Git tools (P2) ───────────────────────────────────────────────
# Master switch; when false no Git tools are registered.
git_enabled=true
# Git operations root (relative to project root).
git_repo_dir=data/repos
# Timeout for a single git call (seconds).
git_timeout_sec=30

# ── Checkpoints (Issue #4: stop / crash resume) ──────────────────
# Master switch; when false no checkpointer is mounted and /resume is
# unavailable (legacy behaviour).
checkpoint_enabled=true
# Storage directory for the sqlite checkpoint store. Empty = <data_dir>/checkpoints.
# Contains full conversation state — never commit it (data/ is git-ignored).
checkpoint_dir=

# ── Snapshots (P1-B: workspace file rollback) ────────────────────
# Every sandbox file write first copies the file's previous bytes to the task
# ledger under this store — outside the sandbox, so glob/grep/read never see
# it. POST /api/tasks/{id}/rollback replays the ledger backwards.
# Master switch; when false nothing is captured and /rollback answers
# {files: []} (pre-P1-B behaviour).
snapshot_enabled=true
# Snapshot store root. Empty = <data_dir>/snapshots. Headless runs keep it
# under the throw-away run root (never inside the workdir the harness owns).
snapshot_dir=
# Task snapshot dirs older than this many days are dropped at startup
# (TaskManager construction). 0 or negative = keep forever.
snapshot_retention_days=30
