# ── LLM provider ───────────────────────────────────────────────
# These LLM_* values only seed the FIRST model profile on startup; after that
# manage profiles in the settings page (data/models.json).
# DeepSeek is the only built-in preset; any other OpenAI-compatible host is a
# custom profile and needs an explicit base_url.
llm_provider=deepseek
# Empty -> the DeepSeek preset endpoint. Set this for a custom compatible host.
llm_base_url=
# Leave empty: the key comes from the profile's env var (LLM_API_KEY) or a
# pasted key in ~/.qianfan/credentials.json (AGENTS.md「密钥」).
llm_api_key=
llm_model=deepseek-chat
# Wall-clock limit for ONE llm request, in seconds. The OpenAI SDK default is
# 600s, which lets a single stalled request eat an entire task budget.
llm_request_timeout_sec=90

# Offline mode: when true, a scripted MockLLMClient is used (no network / key).
use_mock_llm=false
# #108: replace the built-in demo script with a JSON one, so offline runs can
# drive any tool sequence (no Key needed). Empty or an unreadable path keeps the
# built-in demo (default behaviour is unchanged).
# Shape: {"plan": [...], "tool_calls": [{"id","name","arguments"}], "final_answer"}.
# Two boundaries worth knowing before pointing this at anything:
#   * Script content goes straight into MockLLMClient.tool_calls with NO tool-name
#     whitelist — this is a dev-time offline surface. The master switch is still
#     use_mock_llm (this key is not even read when it is false).
#   * One call is emitted per agent turn and the client lives for the whole process,
#     so the script is *consumed*, not replayed: a task that runs to completion burns
#     every call and all later tasks get a bare final_answer. Restart the process to replay.
mock_llm_script_path=
# The offline *test suite* is stricter than this switch and needs no entry here:
# backend/tests/conftest.py removes the LangSmith tracing switches and keys the
# LangChain / LangGraph SDKs read for themselves, so an exported
# LANGSMITH_TRACING=true can never make `pytest backend/tests/` dial out (#84).
# Runtime — this .env, uvicorn — is untouched by that.

# ── Agent ──────────────────────────────────────────────────────
# Max agent calls per round (the round's step budget) before finish is forced.
max_steps=15

# ── Bash tool ──────────────────────────────────────────────────
# Default wall-clock timeout (seconds) for one bash command (a call may pass
# its own `timeout`). Configured and per-call values are capped at 600s; long
# commands are killed as a process tree.
sandbox_timeout=30
# Explicit bash executable. Empty = discover it: the Git installation that owns
# the `git` on PATH, then PATH. C:\Windows\System32\bash.exe (the WSL stub) is ignored.
bash_path=

# ── Web search ─────────────────────────────────────────────────
# duckduckgo (free, no key) | serpapi (requires serpapi_key) | exa (requires EXA_API_KEY)
# duckduckgo may be unreachable from mainland China; exa is the practical fallback.
search_provider=duckduckgo
serpapi_key=
# Exa key: export EXA_API_KEY in the environment; leave this empty in .env.
exa_api_key=

# ── Persistence ────────────────────────────────────────────────
# Relative paths resolve against the project root.
data_dir=data
artifacts_dir=data/artifacts

# ── Server ─────────────────────────────────────────────────────
# 本章只支持本机访问：监听回环地址，Host 检查只认 127.0.0.1 / localhost，
# 跨域只放行自身页面（应用自身 + 开发态 Vite）。远程访问不在本章范围。
host=127.0.0.1
port=8000
# 留空 = 只放行应用自身来源（按 port 推导）；只有显式 `*` 才通配（审计 F6）。
cors_origins=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# Built frontend served by `qianfan`; relative paths resolve against the repo root.
frontend_dist=frontend/dist

# ── Auth (disabled for local demo; enable on public deployments) ──
auth_enabled=false
auth_token=changeme
# Lifetime of issued tokens (seconds).
auth_token_ttl_sec=86400

# ── Context compression (P0) ─────────────────────────────────────
# Estimated tokens above this budget trigger compression (chars/4 estimate).
# 32000 ≈ a conservative mapping of dsh's ratio policy (0.8 x model window) for a
# 128K-window model: chars/4 under-counts real tokens 2~3x for Chinese-heavy
# history, so we do not copy the literal ~105K. Raise/lower freely.
context_token_budget=32000
# Keep the most recent N raw messages when compressing.
context_keep_recent=10
# 0 = only token-triggered; >0 also triggers by message count.
context_max_messages=0
# truncate (default, zero extra LLM calls) | summarize (requires LLM).
context_compress_strategy=truncate
context_summary_max_tokens=300

# ── Context injection (P1-A′) ────────────────────────────────────
# Master switch: inject the two-layer AGENTS.md chain (home ~/.agents/AGENTS.md
# then the workspace root = artifacts_dir), the skills catalogue and the
# environment facts into the agent node's system prompt. Discovered+merged
# once per task — mid-task edits take effect on the NEXT task. The block is not
# counted against context_token_budget; false = pre-P1-A′ behaviour.
context_inject_enabled=true
# Character budget for the rendered skills cards (`- name: description`). Over
# budget drops whole cards from the tail; AGENTS.md and the env facts are never
# trimmed. Skills are discovered at ~/.agents/skills/*/SKILL.md and
# <artifacts_dir>/.agents/skills/*/SKILL.md; only name/description are used.
context_inject_skills_budget=4000

# ── Tool-result eviction (T1.4) ──────────────────────────────────
# Before compression, old tool results longer than the threshold are replaced
# in place by a placeholder: marker + tool name + original size + trace pointer
# + a head/tail preview. Purely mechanical (zero extra LLM calls); the full
# text stays in data/traces/<task_id>.jsonl. false = pre-T1.4 behaviour.
context_evict_enabled=true
# A single tool message longer than this many characters gets evicted.
context_evict_threshold_chars=4000
# The most recent N messages are never evicted (positional, role-agnostic).
context_evict_protect_recent=10
# Head/tail preview kept inside the placeholder.
context_evict_head_chars=800
context_evict_tail_chars=400

# ── Trace (P0) ───────────────────────────────────────────────────
trace_enabled=true
trace_dir=data/traces

# ── Danger policy (S2: 设置里的规则表 + 一个钩子, #136) ───────────
# 危险动作在**执行前**被这张表当场拒：命中即不执行，把 {block, reason} 当这次调用的
# 结果回给模型（模型自己换路）。不弹框、不进图重入、不改参数、不 terminate
# （与 pi 的 tool_call 钩子有意分歧，见 docs/adr/0008 的对照表）。
# JSON 数组，**空表 = 不拦**（与改造前逐字节一致）。每项：
#   {"tool": "<工具名，支持 fnmatch 通配，如 mcp__*__write>",
#    "pattern": "<可选；对入参里每个文本叶子（字符串值，以及数字/布尔的文本形式）做不区
#                 分大小写的正则搜索，不看键名、不做 JSON 转义。注意：argv 被拆成
#                 ["rm","-rf","/"] 这类多元素时，写成一整条命令的模式命不中——模式对
#                 每个叶子各自 search，不跨叶子拼接>",
#    "reason": "<可选；回给模型的拒绝理由，缺省为 '<tool> is blocked by policy'>"}
# 配置写坏时只作废、不炸运行，但**会出声**：非对象的条目、缺 "tool" 的条目、正则不合法
# （含 `a{99999999999}` 这类重复次数过大）→ 该条 warning 后作废；整表不是合法 JSON 数组
# → warning 后**整表作废**（表整个失效 = 什么都不拦，静默失效太危险，所以这一档补了
# warning；与 mcp_servers 的静默回退不同）。
# `""` / `[]` / `null` 是「我就是要空表」，不算写坏、不出声。
# 例：拦掉 shell 里的 rm -rf
#   policy_rules=[{"tool":"bash","pattern":"rm\\s+-rf","reason":"destructive shell command"}]
policy_rules=[]

# ── Sub-agent (P1; 能力面两档见 #56) ─────────────────────────────
# Mounts the spawn_subagent tool. #56 removed the keyword auto-split entry,
# so this switch now gates exactly that one tool (off = not on the face).
subagent_enabled=true
# Pool workers: how many subtasks may run at the same time (1 = serial).
subagent_max_concurrency=2
# Wall-clock bound for a single subtask; over it the subtask folds back failed.
# The fold also asks the worker itself to stop (#71): it unwinds at the next
# node entry, so the pool slot comes back there instead of at max_steps.
subagent_timeout_sec=120

# ── MCP client (P2) ──────────────────────────────────────────────
# Master switch; when false no MCP servers are connected and no MCP tools exist.
mcp_enabled=true
# JSON array: [{name, command, args[], env{}, enabled, cwd?, transport?, url?}]
# Example: [{"name":"fs","command":"npx.cmd","args":["-y","@modelcontextprotocol/server-filesystem","./data"],"enabled":true}]
# Windows note: use "npx.cmd" (or a full Node path) so subprocess can resolve it.
mcp_servers=[]
# Timeout for a single MCP call_tool (seconds).
mcp_timeout_sec=30
# Timeout for initialize + list_tools per server (seconds).
mcp_connect_timeout_sec=15
# MCP danger is classified from what each server self-reports in its tool
# annotations (destructiveHint / readOnlyHint); a tool that reports nothing
# reads as `unknown` instead of safe (Issue #57). Inert metadata — nothing acts
# on it for a verdict.

# ── Checkpoints (Issue #4: stop / crash resume) ──────────────────
# Master switch; when false no checkpointer is mounted and /resume is
# unavailable (legacy behaviour).
checkpoint_enabled=true
# Storage directory for the sqlite checkpoint store. Empty = <data_dir>/checkpoints.
# Contains full conversation state — never commit it (data/ is git-ignored).
checkpoint_dir=
