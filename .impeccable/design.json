      "html": "<div class=\"ds-task-row ds-task-row-selected\" role=\"button\" tabindex=\"0\" aria-pressed=\"true\"><span class=\"ds-task-main\"><span class=\"ds-task-title\">先写一份简短计划并停下</span><span class=\"ds-task-meta\"><span class=\"ds-status-dot\"></span><span class=\"ds-status-word\">已停下</span><time class=\"ds-task-time\">4 分钟前</time></span></span></div>",
      "css": ".ds-task-row{display:flex;align-items:flex-start;box-sizing:border-box;padding:8px 10px;border-radius:0;color:var(--color-secondary);font-family:var(--font-sans);cursor:pointer;transition:background-color 150ms ease,color 150ms ease}.ds-task-row:hover{background:var(--color-surface-hover);color:var(--color-primary)}.ds-task-row-selected{color:var(--color-primary);box-shadow:inset 2px 0 0 var(--color-primary)}.ds-task-main{min-width:0;flex:1}.ds-task-title{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;line-height:1.375}.ds-task-meta{display:flex;align-items:center;gap:8px;margin-top:4px}.ds-status-dot{width:6px;height:6px;border-radius:999px;background:var(--color-state-warn)}.ds-status-word{font-size:12px;line-height:1.6;color:var(--color-secondary)}.ds-task-time{color:var(--color-tertiary);font-family:var(--font-mono);font-size:11px;line-height:1.5;font-variant-numeric:tabular-nums}"
    },
