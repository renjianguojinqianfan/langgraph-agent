      "html": "<div class=\"ds-tabs\" role=\"tablist\" aria-label=\"右栏页签\"><div class=\"ds-tab ds-tab-active\" role=\"tab\" aria-selected=\"true\" tabindex=\"0\">文件</div><div class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">计划</div><div class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">事件</div></div>",
      "css": ".ds-tabs{display:flex;align-items:center;gap:4px;border-bottom:1px solid var(--color-rule);background:var(--color-surface-column)}.ds-tab{display:flex;align-items:center;height:36px;padding:0 10px;color:var(--color-tertiary);font-family:var(--font-sans);font-size:12px;line-height:1.6;cursor:pointer;transition:color 150ms ease}.ds-tab:hover{color:var(--color-secondary)}.ds-tab-active{position:relative;color:var(--color-primary)}.ds-tab-active::after{content:\"\";position:absolute;left:6px;right:6px;bottom:0;height:2px;background:var(--color-primary)}.ds-tab:focus-visible{outline:2px solid var(--color-signal-now);outline-offset:2px}"
    },
