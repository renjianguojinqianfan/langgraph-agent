      "html": "<pre class=\"ds-well\">1  hello</pre>",
      "css": ".ds-well{margin:0;box-sizing:border-box;max-height:420px;overflow:auto;padding:12px;border-radius:var(--radius-well);background:var(--color-surface-well);color:var(--color-secondary);font-family:var(--font-mono);font-size:12px;line-height:1.7;white-space:pre-wrap;word-break:break-word}"
    }
